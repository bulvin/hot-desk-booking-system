{
  "ConnectionStrings": {
    "Database": ""
  },
  "Keycloak": {
    "Authority": "https://identity.example.com/realms/hotdesk",
    "Audience": "hotdesk-api",
    "ClientSecret": "",
    "SwaggerClientId": "hotdesk-swagger",
    "RequireHttpsMetadata": true,
    "IntrospectionTimeoutSeconds": 10
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "Properties": { "Application": "HotDeskBooking" },
    "WriteTo": {
      "Console": {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext} {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    }
  },
  "RateLimiting": {
    "IpPermitLimit": 1200,
    "UserPermitLimit": 120,
    "WritePermitLimit": 20,
    "WindowSeconds": 60
  },
  "ReverseProxy": {
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1
  },
  "AllowedHosts": "*",
  "Database": {
    "SeedSampleData": false
  }
}
