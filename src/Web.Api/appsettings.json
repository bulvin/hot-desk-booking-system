{
  "ConnectionStrings": {
    "Database": ""
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Application": "HotDeskBooking"
    },
    "WriteTo": {
      "Console": {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext} {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    }
  },
  "RateLimiting": {
    "IpPermitLimit": 1200,
    "UserPermitLimit": 120,
    "WritePermitLimit": 20,
    "WindowSeconds": 60
  },
  "AllowedHosts": "*",
  "Database": {
    "SeedSampleData": false
  },
  "Jwt": {
    "Issuer": "hotdesk",
    "Audience": "hotdesk-api",
    "SigningKey": "",
    "AccessTokenMinutes": 10,
    "SessionDays": 7
  },
  "Authentication": {
    "BrowserOrigin": "https://localhost:5173",
    "AllowInsecureCookies": false
  }
}
